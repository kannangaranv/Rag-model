## Vector DB selection: set to "faiss" or "pinecone"
# VECTOR_DB=pinecone
VECTOR_DB=milvus

MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=sample_collection

PAPER_VECTOR_DB=milvus
PAPER_MILVUS_COLLECTION=sample_paper_collection

USER_ROLE_VECTOR_DB=milvus
USER_ROLE_PINECONE_INDEX_NAME=sample-user-role-index
USER_ROLE_MILVUS_COLLECTION=sample_user_role_collection

# optional
MILVUS_TOKEN=example_user:example_password
MILVUS_REQUIRE_AUTH=true
# MILVUS_DB_NAME=sample_database

## Pinecone (required only if VECTOR_DB=pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=sample-index
PAPER_PINECONE_INDEX_NAME=sample-paper-index

OPENAI_API_KEY=your_openai_api_key_here

SQL_SERVER=YOUR_SQL_SERVER_HOST
SQL_DATABASE=SampleDatabase
SQL_USER=your_sql_username
SQL_PASSWORD=your_sql_password
SQL_DRIVER=ODBC Driver 18 for SQL Server

JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

EMBEDDING_MODEL=text-embedding-3-small

# Retrieval reranking
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MANUAL_RERANK_CANDIDATES=12
PAPER_RERANK_CANDIDATES=20
PERMISSION_RERANK_CANDIDATES=100
MANUAL_RERANK_MAX_DOC_CHARS=2500
PAPER_RERANK_MAX_DOC_CHARS=1200
PERMISSION_RERANK_MAX_DOC_CHARS=2500

# Paper-first fallback decision (high-accuracy mode)
PAPER_FALLBACK_JUDGE_ENABLED=true
PAPER_FALLBACK_MIN_DOCS=2
PAPER_FALLBACK_MIN_RELEVANCE=0.08

# Chunking (word-based, not tokenizer token-based)
MANUAL_CHUNK_SIZE=500
MANUAL_CHUNK_OVERLAP=100
PAPER_CHUNK_SIZE=100
PAPER_CHUNK_OVERLAP=20

# Retrieval
MANUAL_RETRIEVAL_K=6
PAPER_RETRIEVAL_K=10
PERMISSION_RETRIEVAL_K=50

